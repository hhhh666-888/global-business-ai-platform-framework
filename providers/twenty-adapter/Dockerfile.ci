# syntax=docker/dockerfile:1.7
FROM node:24.19.0-alpine
WORKDIR /app
RUN --mount=type=bind,source=.ci/npm-cache,target=/opt/gbap-ci/npm-cache,readonly \
    npm init -y >/dev/null 2>&1 \
    && npm install --offline --cache /opt/gbap-ci/npm-cache --omit=dev --no-audit --no-fund --package-lock=false --no-save pg@8.16.3
COPY providers/twenty-adapter/server.mjs ./server.mjs
COPY providers/twenty-adapter/extended.mjs ./extended.mjs
EXPOSE 8091
CMD ["node", "extended.mjs"]
